# ---------------------------------------------------------------------------
# Copy this file to `.env` and edit it.   (macOS/Linux/WSL: cp .env.example .env)
# Lines starting with # are ignored. NEVER commit your real .env to Git (.gitignore already excludes it).
# ---------------------------------------------------------------------------

# 1) WHICH LLM? -------------------------------------------------------------
# mock = no LLM at all (deterministic stand-ins). Everything runs offline. START HERE.
LLM_PROVIDER=mock

# --- MiniMax (OpenAI-compatible endpoint: https://api.minimax.io/v1) -------
# Model routing: MiniMax-M3 for planning/synthesis, MiniMax-M3.1-Flash for fast extraction/routing/grading
# LLM_PROVIDER=minimax
# MINIMAX_API_KEY=sk-api-sadew
# MINIMAX_BASE_URL=https://api.minimax.io/v1
# LLM_MODEL=MiniMax-M3
# LLM_SMALL_MODEL=MiniMax-M3.1-Flash
# PRICE_IN_PER_MTOK=0.15
# PRICE_OUT_PER_MTOK=0.60

# --- Free / free-quota options (pick ONE, uncomment its lines) -------------
# Google Gemini (free tier; key from https://aistudio.google.com/apikey)
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=your-key
# LLM_MODEL=gemini-3.8-flash

# Groq (free plan with rate limits; key from https://console.groq.com/keys)
# LLM_PROVIDER=groq
# GROQ_API_KEY=your-key
# LLM_MODEL=openai/gpt-oss-20b
# LLM_SMALL_MODEL=llama-3.3-70b-versatile

# Ollama (100% local and free; install from https://ollama.com, then: ollama pull qwen3:8b)
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen3:8b

# OpenRouter (DeepSeek etc.; key from https://openrouter.ai)
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=your-key
# LLM_MODEL=deepseek/deepseek-chat

# 2) WHICH SEARCH? ----------------------------------------------------------
# offline = the fictional vendor web in data/vendor_web/corpus.json (repeatable, safe, free)
SEARCH_PROVIDER=offline
# ddgs    = real web search via DuckDuckGo, 100% free, no API key needed (uv pip install ddgs trafilatura)
# SEARCH_PROVIDER=ddgs
# tavily  = real web search API built for agents (1,000 free monthly credits at https://tavily.com)
# SEARCH_PROVIDER=tavily
# TAVILY_API_KEY=tvly-your-key

# 3) LOCAL EMBEDDINGS & RERANKER (Milestone 1 — 100% free on CPU/WSL2) ------
# auto = uses fastembed / sentence-transformers if installed, otherwise built-in semantic vector + cross-encoder
EMBEDDER=auto
EMBED_MODEL=BAAI/bge-small-en-v1.5
RERANKER=auto
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# 4) AGENT SETTINGS (defaults are fine) --------------------------------------
# VRA_AS_OF=2026-11-01         # "today" for freshness maths (offline mode pins this date from the corpus)
# VRA_MAX_USD=0.30             # hard budget per assessment in live mode
# VRA_MAX_PARALLEL=4           # parallel workers for vendor research
# VRA_RESULTS_PER_QUERY=5
# VRA_VERBOSE=1

# 5) BUG-FIX AGENT (scripts/bugfix_agent.py) ----------------------------------
# The agent needs a model with tool-calling support. Leave blank to reuse LLM_PROVIDER / LLM_MODEL above.
# BUGFIX_LLM_PROVIDER=
# BUGFIX_LLM_MODEL=
# BUGFIX_MAX_USD=1.00     # hard budget per phase (diagnose, fix)
# BUGFIX_MAX_STEPS=25     # max tool-calling turns per phase

# 6) PER-ROLE MODELS AND RESILIENCE -------------------------------------------
# Roles: main (planning, synthesis), small (routing, grading, injection/identity classification), extract (page reading).
# Each role defaults to LLM_PROVIDER. Point "small" at the local llama.cpp server (scripts/serve_local_llm.sh).
# LLM_SMALL_PROVIDER=llamacpp
# LLM_EXTRACT_PROVIDER=minimax
# LLAMACPP_BASE_URL=http://localhost:8080/v1
# LLAMACPP_API_KEY=local
# LLAMACPP_MODEL=local-small
# LLM_FALLBACK=1                 # local server down or slow -> the cloud small model (circuit breaker), then mock rules
# LLM_TIMEOUT_S=60
# LLM_SMALL_TIMEOUT_S=30       # cap for the small and extract roles (normal answers take 2-15 s); also bounded by the time the run has left
# LLM_REASONING_EFFORT=          # main role; low|medium|high where the provider supports it
# LLM_SMALL_REASONING_EFFORT=low # small + extract roles: reading pages does not need long reasoning, and it is slow
# Prices (USD per million tokens) used by the cost dashboard and the budget
# PRICE_IN_PER_MTOK=0.15
# PRICE_OUT_PER_MTOK=0.60

# 7) RESEARCH BUDGETS AND SPEED --------------------------------------------------
# VRA_MAX_SECONDS=90             # wall clock per assessment, including routing; at the deadline research returns what it has
# VRA_MAX_TOKENS=400000
# VRA_MAX_TOOL_CALLS=120         # searches + fetches
# VRA_MAX_ITERATIONS=2           # research passes (a second pass only for fields still weak)
# VRA_PLANNER=template           # template | llm (template is faster and repeatable)
# VRA_PAGES_PER_QUESTION=2
# VRA_FETCH_TIMEOUT_S=12
# VRA_FETCH_MAX_BYTES=5000000
# VRA_FETCHER_URL=               # sandboxed fetch service (docker compose "fetcher"); empty = fetch in-process
# INJECTION_MODEL=models/injection/deberta-v3-base-prompt-injection-v2/onnx   # local ONNX classifier, an extra layer only
# TAVILY_MONTHLY_CREDITS=1000    # for the cost dashboard

# 8) LOCAL MODEL FILES ------------------------------------------------------------
# Embedder and reranker are loaded from this cache first; a missing model is downloaded with a deadline, and the
# builtin backend is used if the download stalls. Pre-download with scripts/setup_models.sh. If downloads stall,
# try HF_HUB_DISABLE_XET=1.
# FASTEMBED_CACHE_PATH=~/.cache/fastembed
# VRA_MODEL_DOWNLOAD=1           # 0 = never download at run time (production)
# VRA_MODEL_LOAD_TIMEOUT_S=90

# 9) SERVICE: AUTH, LIMITS, CACHES, LOGS ----------------------------------------
# VRA_ENV=dev                    # dev = demo tokens and a group picker; prod = every endpoint except /health needs a token
# VRA_TOKENS_FILE=               # JSON of sha256(token) -> user, groups, roles (see scripts/manage_tokens.py)
# VRA_MAX_CONCURRENT_JOBS=2
# VRA_RATE_PER_MIN=60
# VRA_MAX_QUESTION_CHARS=2000
# VRA_DAILY_USD=0                # 0 = no cap; otherwise new live runs are refused above the cap
# VRA_MONTHLY_USD=0
# VRA_CACHE=1                    # 0 turns every cache off (the test suite does)
# VRA_SEMANTIC_CACHE_THRESHOLD=0.92
# VRA_SEMANTIC_CACHE_TTL_S=604800
# VRA_SEARCH_CACHE_TTL_S=86400
# VRA_PAGE_CACHE_TTL_S=604800
# VRA_LOG_LEVEL=INFO
# VRA_LOG_JSON=1
# OTEL_EXPORTER_OTLP_ENDPOINT=   # e.g. http://localhost:4317 (Jaeger from the obs profile)
# GRAFANA_PASSWORD=              # REQUIRED to start the obs profile (Grafana refuses to start without it; no default admin/admin)
# GRAFANA_USER=admin
