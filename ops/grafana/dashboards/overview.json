     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "description": "A rising share of UNKNOWN means research is finding less evidence (blocked sites, budget stops)."
  },
