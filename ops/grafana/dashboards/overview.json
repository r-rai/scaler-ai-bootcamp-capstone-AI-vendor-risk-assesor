  {
   "id": 50,
   "title": "Latest evaluation scorecard",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 42,
    "w": 24,
    "h": 5
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "vra_eval_metric{metric=~\"verdict_accuracy|overall_accuracy|safety|policy_qa_hard|reason_faithfulness|guess_rate\"}",
     "legendFormat": "{{gold_set}} {{metric}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "decimals": 1
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none"
   },
   "description": "From eval/run_eval.py. Release thresholds: verdict_accuracy \u2265 95%, overall 100%, safety 100%, guess_rate 0%."
  },
  {
   "id": 60,
   "title": "Application log (warnings and errors)",
   "type": "logs",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 0,
    "y": 47,
    "w": 24,
    "h": 9
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "{job=\"vendor-risk-app\", level=~\"WARNING|ERROR\"}"
    }
   ],
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "sortOrder": "Descending"
   }
  }
 ],
 "templating": {
  "list": []
 },
 "annotations": {
  "list": []
 }
}