        {"field": "subprocessors", "evidence_level": "documented", "value": [{"name": "AWS", "purpose": "cloud hosting", "category": "hosting", "country": "India, US, EU"}, {"name": "Azure OpenAI", "purpose": "LLM inference", "category": "model_provider", "country": "United States"}], "display": "AWS (hosting) and Azure OpenAI (model provider)"},
