      "mock_claims": [
        {"field": "legal_entity", "evidence_level": "documented", "value": {"name": "Freshworks Inc", "country": "United States", "hq_city": "San Mateo"}, "display": "Freshworks Inc (United States / Chennai)"},
        {"field": "security_certifications", "evidence_level": "documented", "value": [{"name": "SOC 2 Type II", "status": "certified", "date": "2026-05-01", "valid_until": null, "issuer": "Independent CPA"}, {"name": "ISO 27001", "status": "certified", "date": "2025-10-01", "valid_until": "2028-10-01", "issuer": "BSI"}], "display": "SOC 2 Type II (2026-05-01) and ISO 27001 (valid to 2028-10-01)"},
